# Copy to .env (never commit .env). On cctv: /home/ziggy/stream-thing-sync/.env

# Google OAuth "Web application" client ID. Public, not a secret.
GOOGLE_CLIENT_ID=2461014992-1sq5ug6j943fr7kiflnehv5u2ckk1278.apps.googleusercontent.com

# Fernet key: encrypts saved API keys and keys the session-id hashes. SECRET.
# Changing it makes every saved API key unreadable and signs everyone out of the website.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Public origin. Cookies are marked Secure when this is https://.
PUBLIC_URL=https://sync.thestoreisclosed.co.uk

# Where sync.db lives inside the container (the compose file mounts SYNC_DATA_DIR here).
DATA_DIR=/data

# --- docker compose only ---
# Host directory for the database (must be writable by HOST_UID:HOST_GID).
SYNC_DATA_DIR=/mnt/data/stream-thing-sync
# Directory holding the tunnel's config.yml and credentials JSON.
CF_CONFIG_DIR=/home/ziggy/.cloudflared/streamsync
HOST_UID=1000
HOST_GID=1000
