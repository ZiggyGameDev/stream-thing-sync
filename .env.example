# Copy to .env (never commit .env). On cctv: /home/ziggy/stream-thing-sync/.env

# Google OAuth "Web application" client ID. Public, not a secret. Used by the
# website's sign-in button, and always accepted by POST /api/auth/google (Android's
# Credential Manager issues ID tokens whose audience is this web client).
GOOGLE_CLIENT_ID=2461014992-1sq5ug6j943fr7kiflnehv5u2ckk1278.apps.googleusercontent.com

# Comma-separated client IDs whose ID tokens POST /api/auth/google accepts
# (GOOGLE_CLIENT_ID is added automatically). Public, not secrets.
GOOGLE_CLIENT_IDS=2461014992-1sq5ug6j943fr7kiflnehv5u2ckk1278.apps.googleusercontent.com,2461014992-ikm313d2pkmpe8r4fe20rq88vis4dgha.apps.googleusercontent.com

# Google OAuth "Desktop app" client, used by POST /api/auth/google-code (the
# Windows app's loopback + PKCE flow). The ID is public.
GOOGLE_DESKTOP_CLIENT_ID=2461014992-ikm313d2pkmpe8r4fe20rq88vis4dgha.apps.googleusercontent.com
# SECRET: the desktop client's secret, from Google Cloud Console. Only ever set it
# here in .env on the server. If blank, /api/auth/google-code answers 503.
GOOGLE_DESKTOP_CLIENT_SECRET=

# Fernet key: encrypts saved API keys and keys the session-id hashes. SECRET.
# Changing it makes every saved API key unreadable and signs everyone out of the website.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Public origin. Cookies are marked Secure when this is https://.
PUBLIC_URL=https://sync.thestoreisclosed.co.uk

# Where sync.db lives inside the container (the compose file mounts SYNC_DATA_DIR here).
DATA_DIR=/data

# --- docker compose only ---
# Host directory for the database (must be writable by HOST_UID:HOST_GID).
SYNC_DATA_DIR=/mnt/data/stream-thing-sync
# Directory holding the tunnel's config.yml and credentials JSON.
CF_CONFIG_DIR=/home/ziggy/.cloudflared/streamsync
HOST_UID=1000
HOST_GID=1000
